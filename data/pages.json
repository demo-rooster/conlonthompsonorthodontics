    {
      "acf_fc_layout": "block_text_simple",
      "title": "Our Mission",
      "paragraphs": [
        {
          "text": "At Lakeshore Orthodontics we deliver orthodontic care with kindness and attention. Each patient is treated as an individual: we listen first, explain options clearly, and design treatment plans that fit real lives."
        },
        {
          "text": "We believe great care should be comfortable and convenient. That means flexible scheduling, clear financial options, and an office team that works to make every visit efficient and stress-free for children, teens, and adults."
        },
        {
          "text": "Our treatment options include traditional braces and clear aligners such as Invisalign<sup>®</sup>, along with retainers and supplemental therapies when appropriate. We help patients understand the process so they can choose the approach that best matches their goals."
        },
        {
          "text": "Using modern imaging, gentle techniques, and ongoing follow-up, our focus is long-term oral health and the confidence that comes with a healthy smile. We aim to make orthodontics accessible, predictable, and positive for every member of our community."
        }
      ],
